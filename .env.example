# 9elf26-jira-stats configuration.
#
# Copy this file to `.env` and fill in your values. The real `.env` is
# gitignored and must never be committed. Every value below has a safe default
# for local fake Jira. To run live, configure both the service account and OAuth.

# --- Jira connection (leave all three blank to use the canned fake Jira) ---
# Base URL of your Jira Cloud site.
JIRA_BASE_URL=
# Service-account email for basic auth.
JIRA_EMAIL=
# Jira API token for the service account (NOT a password). Keep this secret.
JIRA_API_TOKEN=

# --- Project / board (used only when live credentials are set) ---
# Project key to sync.
JIRA_PROJECT=DCAI
# Agile board id backing the project.
JIRA_BOARD_ID=8

# --- Atlassian OAuth 2.0 (required with live Jira) ---
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# Exact registered HTTPS URL, including /auth/callback.
JIRA_OAUTH_REDIRECT_URI=
JIRA_OAUTH_CLOUD_ID=
# Comma-separated Atlassian account IDs, provided by the deployment operator.
JIRA_OAUTH_ALLOWED_ACCOUNT_IDS=
# Standard base64 of 32 random bytes, generated with openssl rand -base64 32.
JIRA_OAUTH_TOKEN_KEY=

# Local review only. JIRA_FAKE=true forces fake Jira even with a site URL set.
JIRA_FAKE=false
# Works only with fake Jira. Set to false when enabling the OAuth login.
AUTH_DISABLED=true

# --- Runtime settings (all optional; defaults shown) ---
# Timezone for date maths and ISO-week (KW##) labels.
TZ=Europe/Berlin
# Background sync interval (Go duration, e.g. 30s, 60s, 5m).
SYNC_INTERVAL=60s
# Trailing ISO weeks shown on the Velocity view (positive integer).
VELOCITY_WEEKS=10
# Address the HTTP server listens on.
LISTEN_ADDR=:8080
# Path to the SQLite database file (Jira projection and encrypted OAuth grants).
DB_PATH=jira-stats.db
